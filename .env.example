# ── Database ──────────────────────────────────────
# Neon PostgreSQL (get a free connection string at https://neon.tech)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/tradinglens?sslmode=require"

# ── NextAuth ─────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ── OAuth Providers ──────────────────────────────
# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ── AI / Trading Data ────────────────────────────
OPENROUTER_API_KEY="your-openrouter-api-key"
# OpenRouter rotates free-tier slugs periodically. When the upstream returns a
# "use this slug instead: X" migration hint, the runtime auto-retries once with X.
# Leave unset (or set to "") to use the hard-coded default below.
OPENROUTER_MODEL="openai/gpt-4o-mini"
# Used automatically when an analysis request includes an image (chart screenshot).
# Default: google/gemini-2.0-flash-exp:free (well-established free vision slug).
OPENROUTER_VISION_MODEL="google/gemini-2.0-flash-exp:free"
GROQ_API_KEY="your-groq-api-key"
# Same auto-heal behavior as OPENROUTER_MODEL — when Groq returns a "use this slug
# instead: X" hint, the runtime retries once with X. Leave unset (or set to "") to
# use the hard-coded default below.
GROQ_MODEL="llama-3.3-70b-versatile"
# Used automatically when an analysis request includes an image.
# Default: llama-3.2-90b-vision-preview (Groq's text-compatible vision model).
GROQ_VISION_MODEL="llama-3.2-90b-vision-preview"
XAI_API_KEY="your-xai-api-key"
# xAI Grok model configuration (Get $25/mo free credits at https://console.x.ai)
# Default text: grok-2-1212 | Default vision: grok-2-vision-1212
XAI_MODEL="grok-2-1212"
XAI_VISION_MODEL="grok-2-vision-1212"
ALPHA_VANTAGE_API_KEY="your-alpha-vantage-api-key"

# ── LiveKit Cloud WebRTC Voice AI ─────────────────
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_AGENT_NAME="Casey-367"
LIVEKIT_AGENT_ID="CA_epNgyMzZocFa"

# ── Payment Gateways ─────────────────────────────
PAYSTACK_SECRET_KEY="your-paystack-secret-key"
PAYSTACK_PUBLIC_KEY="your-paystack-public-key"
FLUTTERWAVE_SECRET_KEY="your-flutterwave-secret-key"
FLUTTERWAVE_PUBLIC_KEY="your-flutterwave-public-key"

# ── App Configuration ────────────────────────────
APP_NAME="TradingLens AI"
APP_URL="https://your-app.vercel.app"
ADMIN_EMAIL="admin@tradinglens.com"

# ── Edu Lens AI Classroom (OpenMAIC) ────────────
# Generate with: openssl rand -hex 32
# This EXACT same value must be set as `ACCESS_CODE` on the OpenMAIC
# deploy. OpenMAIC's middleware verifies it natively; the embedded
# /api/access-code/verify endpoint sets the auth cookie.
OPENMAIC_SHARED_SECRET=""

# Public URL of the deployed OpenMAIC instance.
# Production: https://classroom.tradinglens.com
# Local dev: http://localhost:3001 (when running `pnpm dev` inside openmaic/)
NEXT_PUBLIC_OPENMAIC_URL="http://localhost:3001"

# Optional brand label shown in OpenMAIC UI overrides.
NEXT_PUBLIC_OPENMAIC_BRAND_NAME="TradingLens Classroom"
